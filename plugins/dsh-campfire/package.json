{
  "name": "campfire-dsh-plugin",
  "version": "2.0.0",
  "type": "module",
  "description": "围炉（campfire）→ DeepSeek Harness 渠道插件：把围炉群消息投进 DSH 会话，把回复发回围炉。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "campfire",
    "围炉",
    "agent",
    "group-chat"
  ],
  "author": "gxfc9867",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxfc9867/campfire.git",
    "directory": "plugins/dsh-campfire"
  },
  "homepage": "https://github.com/gxfc9867/campfire/tree/main/plugins/dsh-campfire#readme",
  "bugs": {
    "url": "https://github.com/gxfc9867/campfire/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
