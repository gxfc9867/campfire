    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
