{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/launch.ps1\"",
            "async": true,
            "timeout": 20,
            "statusMessage": "Starting Campfire adapter"
          }
        ]
      }
    ]
  }
}
