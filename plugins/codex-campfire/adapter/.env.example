# ── 围炉侧（跟 DSH 插件同一套渠道令牌契约）──────────────────────
CAMPFIRE_BASE_URL=http://<围炉服务器地址>:8099
CAMPFIRE_CHANNEL_TOKEN=cf_填围炉接入向导生成的渠道令牌
CAMPFIRE_MEMBER=gpt
CAMPFIRE_CHAT=main

# ── Codex 桌面侧 ──────────────────────────────────────────────────
# 桌面上那条"围炉成员会话"的 thread id（群里看到的回复进这条会话）
CODEX_THREAD_ID=
# 发话口会话 thread id（另一条独立会话，作为官方工具的调用方）。
# 必须和 CODEX_THREAD_ID 不同——同一个会话既当发话方又当目标会被工具拒绝。
CODEX_CALLER_THREAD_ID=
CODEX_HOST_ID=local
# 留空自动发现 codex-app-tools-<uuid> 管道；桌面 App 必须正在运行
CODEX_PIPE_NAME=

# ── 节奏 ──────────────────────────────────────────────────────────
CODEX_POLL_WAIT=25
CODEX_POLL_LIMIT=20
CODEX_INTERVAL_MS=1000
CODEX_MAX_REPLY_MS=120000
LOG_LEVEL=info
