# DSH 接入围炉适配器配置模板。
# 复制为 adapters/dsh/.env 并填好；.env 不要提交到 git。
#
# ── 围炉地址（compose 里已注入，可留默认）──────────────────────────
# CAMPFIRE_URL=http://127.0.0.1:8099

# ── 成员 1：恭喜（NAS 端 DSH）─────────────────────────────────────
# handle/key 来自围炉「成员管理」创建 pull 型成员后返回的密钥
MEM1_HANDLE=gongxi
MEM1_KEY=在围炉里创建成员后粘贴
MEM1_NAME=恭喜
# NAS 本机的 DSH Web Host（桥在用的同一个）
MEM1_DSH_BASE=http://127.0.0.1:3081
MEM1_WORKSPACE=/root/NAS
# mint = 用凭据密钥离线签发 Cookie（compose 已挂载 credentials.yaml）
MEM1_COOKIE=mint

# ── 成员 2：发财（电脑端 DSH）─────────────────────────────────────
MEM2_HANDLE=facai
MEM2_KEY=在围炉里创建成员后粘贴
MEM2_NAME=发财
# 经 SSH 隧道到电脑端 Web Host（桥维护的隧道，19387）
MEM2_DSH_BASE=http://127.0.0.1:19387
MEM2_WORKSPACE=
# pc = 读桥同步来的 Cookie 缓存（compose 已挂载），失效时走 SSH 兜底
MEM2_COOKIE=pc

# ── 发财的 SSH 兜底（可选；不配则只依赖桥的缓存和隧道）────────────
# 电脑端的局域网地址
# PC_SSH_HOST=192.168.31.x
# PC_SSH_PORT=22
# PC_SSH_USER=user
# PC_SSH_KEY=/keys/pc_id_ed25519
# PC_WIN_COOKIE_PATH=E:\Software\dsh-home\.desktop-web-cookie-persist
# PC_COOKIE_CACHE=/pc/.desktop-cookie-cache

# ── 其他 ─────────────────────────────────────────────────────────
# 恭喜 Cookie 的签发密钥来源（compose 已注入，一般不用动）
BRIDGE_NAS_CREDENTIALS=/cred/credentials.yaml
BRIDGE_NAS_SECRET_RECORD=client-connection/browser-session
# DSH 单回合最长等待（毫秒）
DSH_TIMEOUT_MS=300000
# 长轮询挂起秒数（要小于围炉 INBOX_WAIT_MAX=50）
POLL_WAIT_SEC=25
