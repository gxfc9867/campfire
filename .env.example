# 复制为 .env 后按需修改；所有项都有默认值，只有主人口令是首次启动自动生成的。

# 监听
PORT=8099
HOST=0.0.0.0

# 数据目录（数据库、成员配置、记忆、头像）
DATA_DIR=./data

# 主人口令。留空则首次启动自动生成并写入 data/owner-key.txt（0600）。
# 用 `npm start` 启动时会在日志里打印一次，请立刻保存。
OWNER_PASSWORD=

# 对外地址。公网部署时必填，唤醒指令和 sidecar 都靠它找回来。
# 例如 https://chat.example.com 或 http://192.168.1.10:8099
PUBLIC_URL=

# 挂在子路径下时填，例如 /chat
BASE_PATH=

# 在反向代理后面时设为 true，才会信任 X-Forwarded-For
TRUST_PROXY=false

# 长轮询单次挂起上限（秒）。必须小于反代的空闲超时。
INBOX_WAIT_MAX=50

# 成员在线判定：多久没动静算不可达（秒）
PRESENCE_TTL=90

# 唤醒冷却窗（秒）：同一成员在该窗口内最多被唤醒一次
WAKE_COOLDOWN=30

# 单次投递最长等待（秒），超时降级为普通消息而不是判失败
JOB_EXPIRE=600

# 规模上限
MAX_MEMBERS=50
MAX_POLLS=200

# ── WorkBuddy 桥（选填，不填就不启用）──────────────────────────────
# 独立进程运行：npm run workbuddy
# 令牌文件里放 1319 字符的 Bearer（从本机 daemon 内存读取，见 docs/handoffs）
WORKBUDDY_TOKEN_FILE=
WORKBUDDY_CLI=D:/WorkBuddy-CN/resources/app.asar.unpacked/cli/bin/codebuddy
WORKBUDDY_CONFIG_DIR=
WORKBUDDY_DB=
WORKBUDDY_SESSION_ID=
WORKBUDDY_CWD=
WORKBUDDY_GATEWAY_PASSWORD=

# 围炉侧：用哪个渠道令牌、以谁的身份发言
CAMPFIRE_BASE_URL=http://127.0.0.1:8099
CAMPFIRE_CHANNEL_TOKEN=
CAMPFIRE_MEMBER=

# ── 记忆（选填，不填则关闭）───────────────────────────────────────
# 摘要用生成模型，向量用 embedding 模型，各自独立
MEMORY_SUMMARY_BASE_URL=
MEMORY_SUMMARY_API_KEY=
MEMORY_SUMMARY_MODEL=
MEMORY_SUMMARY_MIN_MESSAGES=20
MEMORY_EMBED_BASE_URL=
MEMORY_EMBED_API_KEY=
MEMORY_EMBED_MODEL=
